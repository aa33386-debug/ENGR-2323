LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY Vhdl1 IS
PORT(
    CLOCK, RESETN    : IN STD_LOGIC;
    ALARM_MODE_SW    : IN STD_LOGIC; 
    ENTER_BTN        : IN STD_LOGIC; – use pin planner to map  as both dismiss & enter button
    INC_HR_BTN       : IN STD_LOGIC; 
    INC_MIN_BTN      : IN STD_LOGIC; 
    DISMISS_BTN      : IN STD_LOGIC; – keep for no compilation errors
    clock_out        : OUT STD_LOGIC;
    LEDS_FLASH       : OUT STD_LOGIC_VECTOR(1 DOWNTO 0); 
    th, oh, tm, om, ts, os: OUT STD_LOGIC_VECTOR(6 DOWNTO 0)
);
END Vhdl1;

ARCHITECTURE behavior of Vhdl1 IS
    TYPE STATETYPE IS (COUNT0, COUNT1, COUNT2, count3, count4, count5, count6, count7, count8, count9);
    SIGNAL STATEOS, STATETS, STATEOM, STATETM, STATEOH, STATETH : STATETYPE;
    
    SIGNAL COUNT : INTEGER := 1;
    SIGNAL TEMP_CLOCK : STD_LOGIC := '0';
    
    SIGNAL LED_COUNT : INTEGER := 1;
    SIGNAL LED_CLK   : STD_LOGIC := '0';
    
    SIGNAL COUNTOS, COUNTTS, COUNTOM, COUNTTM, COUNTOH, COUNTTH : INTEGER := 0;
    SIGNAL ALARM_OM, ALARM_TM, ALARM_OH, ALARM_TH : INTEGER := 0;
    SIGNAL DISP_OS, DISP_TS, DISP_OM, DISP_TM, DISP_OH, DISP_TH : INTEGER := 0;
    
    SIGNAL ALARM_ACTIVE : STD_LOGIC := '0';
    SIGNAL SETTING_DONE : STD_LOGIC := '0';
    
    SIGNAL HR_BTN_REG, MIN_BTN_REG, ENTER_BTN_REG : STD_LOGIC := '1';

BEGIN

    -- changing the Hz to 1 for clock and 4 for LEDs
    PROCESS (CLOCK, RESETN)
    BEGIN
        IF (RESETN = '0') THEN
            COUNT <= 1;
            LED_COUNT <= 1;
            TEMP_CLOCK <= '0';
            LED_CLK <= '0';
        ELSIF (RISING_EDGE(CLOCK)) THEN
            
            IF (COUNT = 25000000) THEN
                TEMP_CLOCK <= NOT(TEMP_CLOCK); 
                COUNT <= 1;
            ELSE
                COUNT <= COUNT + 1;
            END IF;
            
            -- Changed to 6250000 to match the 4Hz toggle requirement comment
            IF (LED_COUNT = 6250000) THEN
                LED_CLK <= NOT(LED_CLK);
                LED_COUNT <= 1;
            ELSE
                LED_COUNT <= LED_COUNT + 1;
            END IF;
        END IF;
    END PROCESS;

    -- setting alarm clock sectrion
    PROCESS(CLOCK, RESETN)
    BEGIN
        IF RESETN = '0' THEN
            ALARM_OM <= 0; ALARM_TM <= 0; ALARM_OH <= 0; ALARM_TH <= 0;
            ALARM_ACTIVE <= '0';
            SETTING_DONE <= '0';
            HR_BTN_REG <= '1'; MIN_BTN_REG <= '1'; ENTER_BTN_REG <= '1';
        ELSIF RISING_EDGE(CLOCK) THEN
            
            HR_BTN_REG <= INC_HR_BTN;
            MIN_BTN_REG <= INC_MIN_BTN;
            ENTER_BTN_REG <= ENTER_BTN;
            
            -- Mode Selection
            IF ALARM_MODE_SW = '1' AND SETTING_DONE = '0' THEN
                -- time of minutes reseting to zero using falling edge
                IF MIN_BTN_REG = '1' AND INC_MIN_BTN = '0' THEN
                    IF ALARM_OM = 9 THEN
                        ALARM_OM <= 0;
                        IF ALARM_TM = 5 THEN
                            ALARM_TM <= 0;
                        ELSE
                            ALARM_TM <= ALARM_TM + 1;
                        END IF;
                    ELSE
                        ALARM_OM <= ALARM_OM + 1;
                    END IF;
                END IF;
                
                -- time of hours reseting using falling edge
                IF HR_BTN_REG = '1' AND INC_HR_BTN = '0' THEN
                    IF (ALARM_TH = 2 AND ALARM_OH = 3) THEN
                        ALARM_OH <= 0;
                        ALARM_TH <= 0;
                    ELSIF ALARM_OH = 9 THEN
                        ALARM_OH <= 0;
                        ALARM_TH <= ALARM_TH + 1;
                    ELSE
                        ALARM_OH <= ALARM_OH + 1;
                    END IF;
                END IF;
                
                -- entering desired alram clock time
                IF ENTER_BTN_REG = '1' AND ENTER_BTN = '0' THEN
                    SETTING_DONE <= '1';
                END IF;
            END IF;
            
            -- Latch to go back to og clock after setting alarm
            IF ALARM_MODE_SW = '0' THEN
                SETTING_DONE <= '0';
            END IF;
            
            -- Alarm Activation Comparator Condition
            IF (COUNTTH = ALARM_TH AND COUNTOH = ALARM_OH AND 
                COUNTTM = ALARM_TM AND COUNTOM = ALARM_OM AND 
                COUNTTS = 0        AND COUNTOS = 0) THEN
                ALARM_ACTIVE <= '1';
            END IF;
            
            -- Cut off alarm button
            IF (ALARM_ACTIVE = '1') THEN
                IF ENTER_BTN_REG = '1' AND ENTER_BTN = '0' THEN 
                    ALARM_ACTIVE <= '0';
                END IF;
            END IF;
        END IF;
    END PROCESS;

    -- Displaying alarm setting values
    PROCESS(ALARM_MODE_SW, COUNTOS, COUNTTS, COUNTOM, COUNTTM, COUNTOH, COUNTTH, ALARM_OM, ALARM_TM, ALARM_OH, ALARM_TH)
    BEGIN
        IF (ALARM_MODE_SW = '1') THEN
            -- Display the alarm configuration values while adjusting
            DISP_OS <= 0; 
            DISP_TS <= 0;
            DISP_OM <= ALARM_OM;
            DISP_TM <= ALARM_TM;
            DISP_OH <= ALARM_OH;
            DISP_TH <= ALARM_TH;
        ELSE
            -- gooinh back to og manuual set clock display 
            DISP_OS <= COUNTOS;
            DISP_TS <= COUNTTS;
            DISP_OM <= COUNTOM;
            DISP_TM <= COUNTTM;
            DISP_OH <= COUNTOH;
            DISP_TH <= COUNTTH;
        END IF;
    END PROCESS;

    -- Led flash
    LEDS_FLASH <= (LED_CLK & NOT(LED_CLK)) WHEN ALARM_ACTIVE = '1' ELSE "00";

    -- state changes
    PROCESS(DISP_OS) BEGIN
        CASE DISP_OS IS
            WHEN 0 => STATEOS <= COUNT0; WHEN 1 => STATEOS <= COUNT1; WHEN 2 => STATEOS <= COUNT2; WHEN 3 => STATEOS <= COUNT3;
            WHEN 4 => STATEOS <= COUNT4; WHEN 5 => STATEOS <= COUNT5; WHEN 6 => STATEOS <= COUNT6; WHEN 7 => STATEOS <= COUNT7;
            WHEN 8 => STATEOS <= COUNT8; WHEN 9 => STATEOS <= COUNT9; WHEN OTHERS => STATEOS <= COUNT0;
        END CASE;
    END PROCESS;

    PROCESS(DISP_TS) BEGIN
        CASE DISP_TS IS
            WHEN 0 => STATETS <= COUNT0; WHEN 1 => STATETS <= COUNT1; WHEN 2 => STATETS <= COUNT2;
            WHEN 3 => STATETS <= COUNT3; WHEN 4 => STATETS <= COUNT4; WHEN 5 => STATETS <= COUNT5; WHEN OTHERS => STATETS <= COUNT0;
        END CASE;
    END PROCESS;

    PROCESS(DISP_OM) BEGIN
        CASE DISP_OM IS
            WHEN 0 => STATEOM <= COUNT0; WHEN 1 => STATEOM <= COUNT1; WHEN 2 => STATEOM <= COUNT2; WHEN 3 => STATEOM <= COUNT3;
            WHEN 4 => STATEOM <= COUNT4; WHEN 5 => STATEOM <= COUNT5; WHEN 6 => STATEOM <= COUNT6; WHEN 7 => STATEOM <= COUNT7;
            WHEN 8 => STATEOM <= COUNT8; WHEN 9 => STATEOM <= COUNT9; WHEN OTHERS => STATEOM <= COUNT0;
        END CASE;
    END PROCESS;

    PROCESS(DISP_TM) BEGIN
        CASE DISP_TM IS
            WHEN 0 => STATETM <= COUNT0; WHEN 1 => STATETM <= COUNT1; WHEN 2 => STATETM <= COUNT2;
            WHEN 3 => STATETM <= COUNT3; WHEN 4 => STATETM <= COUNT4; WHEN 5 => STATETM <= COUNT5; WHEN OTHERS => STATETM <= COUNT0;
        END CASE;
    END PROCESS;

    PROCESS(DISP_OH) BEGIN
        CASE DISP_OH IS
            WHEN 0 => STATEOH <= COUNT0; WHEN 1 => STATEOH <= COUNT1; WHEN 2 => STATEOH <= COUNT2; WHEN 3 => STATEOH <= COUNT3;
            WHEN 4 => STATEOH <= COUNT4; WHEN 5 => STATEOH <= COUNT5; WHEN 6 => STATEOH <= COUNT6; WHEN 7 => STATEOH <= COUNT7;
            WHEN 8 => STATEOH <= COUNT8; WHEN 9 => STATEOH <= COUNT9; WHEN OTHERS => STATEOH <= COUNT0;
        END CASE;
    END PROCESS;

    PROCESS(DISP_TH) BEGIN
        CASE DISP_TH IS
            WHEN 0 => STATETH <= COUNT0; WHEN 1 => STATETH <= COUNT1; WHEN 2 => STATETH <= COUNT2; WHEN OTHERS => STATETH <= COUNT0;
        END CASE;
    END PROCESS;

    -- the worst part of output configiration
    os <= "1000000" WHEN STATEOS = COUNT0 ELSE "1111001" WHEN STATEOS = COUNT1 ELSE "0100100" WHEN STATEOS = COUNT2 ELSE "0110000" WHEN STATEOS = COUNT3 ELSE "0011001" WHEN STATEOS = COUNT4 ELSE "0010010" WHEN STATEOS = COUNT5 ELSE "0000010" WHEN STATEOS = COUNT6 ELSE "1111000" WHEN STATEOS = COUNT7 ELSE "0000000" WHEN STATEOS = COUNT8 ELSE "0010000" WHEN STATEOS = COUNT9 ELSE "1000000";
    ts <= "1000000" WHEN STATETS = COUNT0 ELSE "1111001" WHEN STATETS = COUNT1 ELSE "0100100" WHEN STATETS = COUNT2 ELSE "0110000" WHEN STATETS = COUNT3 ELSE "0011001" WHEN STATETS = COUNT4 ELSE "0010010" WHEN STATETS = COUNT5 ELSE "1000000";
    om <= "1000000" WHEN STATEOM = COUNT0 ELSE "1111001" WHEN STATEOM = COUNT1 ELSE "0100100" WHEN STATEOM = COUNT2 ELSE "0110000" WHEN STATEOM = COUNT3 ELSE "0011001" WHEN STATEOM = COUNT4 ELSE "0010010" WHEN STATEOM = COUNT5 ELSE "0000010" WHEN STATEOM = COUNT6 ELSE "1111000" WHEN STATEOM = COUNT7 ELSE "0000000" WHEN STATEOM = COUNT8 ELSE "0010000" WHEN STATEOM = COUNT9 ELSE "1000000";
    tm <= "1000000" WHEN STATETM = COUNT0 ELSE "1111001" WHEN STATETM = COUNT1 ELSE "0100100" WHEN STATETM = COUNT2 ELSE "0110000" WHEN STATETM = COUNT3 ELSE "0011001" WHEN STATETM = COUNT4 ELSE "0010010" WHEN STATETM = COUNT5 ELSE "1000000";
    oh <= "1000000" WHEN STATEOH = COUNT0 ELSE "1111001" WHEN STATEOH = COUNT1 ELSE "0100100" WHEN STATEOH = COUNT2 ELSE "0110000" WHEN STATEOH = COUNT3 ELSE "0011001" WHEN STATEOH = COUNT4 ELSE "0010010" WHEN STATEOH = COUNT5 ELSE "0000010" WHEN STATEOH = COUNT6 ELSE "1111000" WHEN STATEOH = COUNT7 ELSE "0000000" WHEN STATEOH = COUNT8 ELSE "0010000" WHEN STATEOH = COUNT9 ELSE "1000000";
    th <= "1000000" WHEN STATETH = COUNT0 ELSE "1111001" WHEN STATETH = COUNT1 ELSE "0100100" WHEN STATETH = COUNT2 ELSE "1000000";

END behavior;




--guide for inputs
--  SWITCHES
-- SW[0] (PIN_AB30)  ALARM_MODE_SW : flip UP to enter Alarm Mode
--                                       to adjust target time
--                                       flip DOWN to return to Clock Mode
--
-- PUSH BUTTONS (KEYS)
--  KEY[0] (PIN_AJ4)   RESETN       : reset button (Active Low)
--                                       Press to clear clock to 00:00:00
-- KEY[1] (PIN_AK4)   ENTER_BTN    : confirms alarm time selection
--                                       Returns screen to runtime clock
-- KEY[2] (PIN_AA14)  INC_HR_BTN   : alarm hour digits
-- KEY[3] (PIN_AA15)  INC_MIN_BTN  :  alarm minute digits

