LIBRARY ieee;
USE ieee.std_logic_1164.all;


ENTITY Vhdl1 IS
PORT(CLOCK, clock_out, RESETN: IN STD_LOGIC;
			th, oh, tm, om, ts, os: OUT STD_LOGIC_VECTOR(6 DOWNTO 0));
END vdhl1;


ARCHITECTURE behavior of vdhl1 IS
TYPE STATETYPE IS (COUNT0, COUNT1, COUNT2, count3, count4, count5, count6, count7, count8, count9);
SIGNAL STATEOS, STATETS, STATEOM, STATETM, STATEOH, STATETH : STATETYPE; signal ce_udn : std_logic_vector (1 downto 0);
SIGNAL COUNT, COUNTOS, COUNTTS, COUNTOM, COUNTTM, COUNTOH, COUNTTH : INTEGER := 0;
SIGNAL TEMP_CLOCK : STD_LOGIC := '0';

BEGIN
	PROCESS (CLOCK, RESETN)
	BEGIN
		COUNT <= 1;
		IF (RESETN = '0') THEN
			COUNT <= 1;
			-- TEMP_CLOCK initialized with 0
			TEMP_CLOCK <= '0';
		ELSIF (RISING_EDGE(CLOCK)) THEN
			COUNT <= COUNT + 1;
			IF (COUNT = 50000000) THEN
				TEMP_CLOCK <= NOT(TEMP_CLOCK); 
				COUNT <= 1;
			END IF;
		END IF;
	END PROCESS;


CLOCK_OUT <= TEMP_CLOCK;

BEGIN
	PROCESS(clock_out, RESETN)
      BEGIN
			IF RESETN = '0' THEN
				STATE <= COUNT0;
			ELSIF RISING_EDGE(clock_out) THEN
				COUNTOS <= COUNTOS + 1;
				IF (COUNTOS = 10) THEN
					COUNTOS <= 0;
					COUNTTS <= COUNTTS + 1;
					IF (COUNTTS = 6) THEN
						COUNTTS <= 0;
						COUNTOM <= COUNTOM + 1;
						IF (COUNTOM = 10) THEN
							COUNTOM <= 0;
							COUNTTM <= COUNTTM + 1;
							IF (COUNTTM = 6) THEN
								COUNTTM <= 0;
								COUNTOH <= COUNTOH + 1;
								IF (COUNTTH = 2) THEN
									IF (COUNTOH = 5)
										COUNTOH <= 0;
										COUNTTH <= 0;
									ELSIF (COUNTOH = 10)
										COUNTOH <= 0;
										COUNTTH <= COUNTTH + 1;
									END IF;
								END IF;
							END IF;
						END IF;
					END IF;
				END IF;
				IF (COUNTOS = 0) THEN
					STATEOS = COUNT0;
				ELSIF (COUNTOS = 1) THEN
					STATEOS = COUNT1;
				ELSIF (COUNTOS = 2) THEN
					STATEOS = COUNT2;
				ELSIF (COUNTOS = 3) THEN
					STATEOS = COUNT3;
				ELSIF (COUNTOS = 4) THEN
					STATEOS = COUNT4;
				ELSIF (COUNTOS = 5 THEN
					STATEOS = COUNT5;
				ELSIF (COUNTOS = 6) THEN
					STATEOS = COUNT6;
				ELSIF (COUNTOS = 7) THEN
					STATEOS = COUNT7;
				ELSIF (COUNTOS = 8) THEN
					STATEOS = COUNT8;
				ELSIF (COUNTOS = 9) THEN
					STATEOS = COUNT9;
				END IF;
				
				IF (COUNTTS = 0) THEN
					STATETS = COUNT0;
				ELSIF (COUNTTS = 1) THEN
					STATETS = COUNT1;
				ELSIF (COUNTTS = 2) THEN
					STATETS = COUNT2;
				ELSIF (COUNTTS = 3) THEN
					STATETS = COUNT3;
				ELSIF (COUNTTS = 4) THEN
					STATETS = COUNT4;
				ELSIF (COUNTTS = 5 THEN
					STATETS = COUNT5;
				END IF;
				
				IF (COUNTOM = 0) THEN
					STATEOM = COUNT0;
				ELSIF (COUNTOM = 1) THEN
					STATEOM = COUNT1;
				ELSIF (COUNTOM = 2) THEN
					STATEOM = COUNT2;
				ELSIF (COUNTOM = 3) THEN
					STATEOM = COUNT3;
				ELSIF (COUNTOM = 4) THEN
					STATEOM = COUNT4;
				ELSIF (COUNTOM = 5 THEN
					STATEOM = COUNT5;
				ELSIF (COUNTOM = 6) THEN
					STATEOM = COUNT6;
				ELSIF (COUNTOM = 7) THEN
					STATEOM = COUNT7;
				ELSIF (COUNTOM = 8) THEN
					STATEOM = COUNT8;
				ELSIF (COUNTOM = 9) THEN
					STATEOM = COUNT9;
				END IF;
				
				IF (COUNTTM = 0) THEN
					STATETM = COUNT0;
				ELSIF (COUNTTM = 1) THEN
					STATETM = COUNT1;
				ELSIF (COUNTTM = 2) THEN
					STATETM = COUNT2;
				ELSIF (COUNTTM = 3) THEN
					STATETM = COUNT3;
				ELSIF (COUNTTM = 4) THEN
					STATETM = COUNT4;
				ELSIF (COUNTTM = 5 THEN
					STATETM = COUNT5;
				END IF;
				
				IF (COUNTOH = 0) THEN
					STATEOH = COUNT0;
				ELSIF (COUNTOH = 1) THEN
					STATEOH = COUNT1;
				ELSIF (COUNTOH = 2) THEN
					STATEOH = COUNT2;
				ELSIF (COUNTOH = 3) THEN
					STATEOH = COUNT3;
				ELSIF (COUNTOH = 4) THEN
					STATEOH = COUNT4;
				ELSIF (COUNTOH = 5 THEN
					STATEOH = COUNT5;
				ELSIF (COUNTOH = 6) THEN
					STATEOH = COUNT6;
				ELSIF (COUNTOH = 7) THEN
					STATEOH = COUNT7;
				ELSIF (COUNTOH = 8) THEN
					STATEOH = COUNT8;
				ELSIF (COUNTOH = 9) THEN
					STATEOH = COUNT9;
				END IF;
				
				IF (COUNTTH = 0) THEN
					STATETH = COUNT0;
				ELSIF (COUNTTH = 1) THEN
					STATETH = COUNT1;
				ELSIF (COUNTTH = 2) THEN
					STATETH = COUNT2;
				END IF;
        END IF;
	END PROCESS;  
      
   OS <= "1000000" WHEN STATEOS = COUNT0 ELSE "1111001" WHEN STATEOS = COUNT1 ELSE "0100100" WHEN STATEOS = COUNT2 ELSE "0110000" WHEN STATEOS = COUNT3 ELSE
"0011001" WHEN STATEOS = COUNT4 ELSE "0010010" WHEN STATEOS = COUNT5 ELSE "0000010" WHEN STATEOS = COUNT6 ELSE "1111000" WHEN STATEOS = COUNT7 ELSE
"0000000" WHEN STATEOS = COUNT8 ELSE "0010000" WHEN STATEOS = COUNT9 ELSE "1000000";
   TS <= "1000000" WHEN STATETS = COUNT0 ELSE "1111001" WHEN STATETS = COUNT1 ELSE "0100100" WHEN STATETS = COUNT2 ELSE "0110000" WHEN STATETS = COUNT3 ELSE
"0011001" WHEN STATETS = COUNT4 ELSE "0010010" WHEN STATETS = COUNT5 ELSE "0000010" WHEN STATETS = COUNT6 ELSE "1111000" WHEN STATETS = COUNT7 ELSE
"0000000" WHEN STATETS = COUNT8 ELSE "0010000" WHEN STATETS = COUNT9 ELSE "1000000";
   OM <= "1000000" WHEN STATEOM = COUNT0 ELSE "1111001" WHEN STATEOM = COUNT1 ELSE "0100100" WHEN STATEOM = COUNT2 ELSE "0110000" WHEN STATEOM = COUNT3 ELSE
"0011001" WHEN STATEOM = COUNT4 ELSE "0010010" WHEN STATEOM = COUNT5 ELSE "0000010" WHEN STATEOM = COUNT6 ELSE "1111000" WHEN STATEOM = COUNT7 ELSE
"0000000" WHEN STATEOM = COUNT8 ELSE "0010000" WHEN STATEOM = COUNT9 ELSE "1000000";
   TM <= "1000000" WHEN STATETM = COUNT0 ELSE "1111001" WHEN STATETM = COUNT1 ELSE "0100100" WHEN STATETM = COUNT2 ELSE "0110000" WHEN STATETM = COUNT3 ELSE
"0011001" WHEN STATETM = COUNT4 ELSE "0010010" WHEN STATETM = COUNT5 ELSE "0000010" WHEN STATETM = COUNT6 ELSE "1111000" WHEN STATETM = COUNT7 ELSE
"0000000" WHEN STATETM = COUNT8 ELSE "0010000" WHEN STATETM = COUNT9 ELSE "1000000";
   OH <= "1000000" WHEN STATEOH = COUNT0 ELSE "1111001" WHEN STATEOH = COUNT1 ELSE "0100100" WHEN STATEOH = COUNT2 ELSE "0110000" WHEN STATEOH = COUNT3 ELSE
"0011001" WHEN STATEOH = COUNT4 ELSE "0010010" WHEN STATEOH = COUNT5 ELSE "0000010" WHEN STATEOH = COUNT6 ELSE "1111000" WHEN STATEOH = COUNT7 ELSE
"0000000" WHEN STATEOH = COUNT8 ELSE "0010000" WHEN STATEOH = COUNT9 ELSE "1000000";
   TH <= "1000000" WHEN STATETH = COUNT0 ELSE "1111001" WHEN STATETH = COUNT1 ELSE "0100100" WHEN STATETH = COUNT2 ELSE "0110000" WHEN STATETH = COUNT3 ELSE
"0011001" WHEN STATETH = COUNT4 ELSE "0010010" WHEN STATETH = COUNT5 ELSE "0000010" WHEN STATETH = COUNT6 ELSE "1111000" WHEN STATETH = COUNT7 ELSE
"0000000" WHEN STATETH = COUNT8 ELSE "0010000" WHEN STATETH = COUNT9 ELSE "1000000";

END behavior;
